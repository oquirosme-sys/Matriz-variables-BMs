+    });
+    return mejor;
+  }
+
+  const rotuloLamina = (base, i) => { const m = /^(.*?)(\d+)$/.exec(String(base || 'BMS-01')); return m ? m[1] + String(Number(m[2]) + i).padStart(m[2].length, '0') : (base || 'BMS') + '-' + (i + 1); };
